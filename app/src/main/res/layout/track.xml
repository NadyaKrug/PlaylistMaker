<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/track_height"
    android:paddingStart="@dimen/track_padding"
    android:paddingEnd="@dimen/track_padding">

    <ImageView
        android:id="@+id/track_image"
        android:layout_width="@dimen/track_image"
        android:layout_height="@dimen/track_image"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_search"
        />

    <TextView
        android:id="@+id/track_name"
        android:layout_width="@dimen/layout_zero"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/track_text"
        android:layout_marginEnd="@dimen/track_text"
        android:maxLines="1"
        android:fontFamily="@font/ys_display_regular"
        android:textColor="@color/track_text"
        android:textSize="@dimen/base_text_size"
        android:ellipsize="end"
        app:layout_constraintBottom_toTopOf="@+id/artist_name"
        app:layout_constraintEnd_toStartOf="@+id/arrow_icon"
        app:layout_constraintStart_toEndOf="@+id/track_image"
        app:layout_constraintTop_toTopOf="@+id/track_image"
        tools:text="Yesterday (Remastered 2009)"

        />

    <TextView
        android:id="@+id/artist_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/track_text"
        android:ellipsize="end"
        android:fontFamily="@font/ys_display_regular"
        android:maxLines="1"
        android:textColor="@color/search_hint"
        android:textSize="@dimen/track_text_size"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/dot_icon"
        app:layout_constraintStart_toEndOf="@+id/track_image"
        app:layout_constraintTop_toBottomOf="@+id/track_name"
        app:layout_constraintBottom_toBottomOf="@+id/track_image"
        tools:text="The Beatles" />


    <ImageView
        android:id="@+id/dot_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:src="@drawable/ic_dot_3"
        app:layout_constraintBottom_toBottomOf="@+id/artist_name"
        app:layout_constraintEnd_toStartOf="@+id/track_time"
        app:layout_constraintStart_toEndOf="@+id/artist_name"
        app:layout_constraintTop_toTopOf="@+id/artist_name"
        app:tint="@color/search_hint" />

    <TextView
        android:id="@+id/track_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ys_display_regular"
        android:maxLines="1"
        android:textColor="@color/search_hint"
        android:textSize="@dimen/track_text_size"
        app:layout_constraintBottom_toBottomOf="@+id/artist_name"
        app:layout_constraintEnd_toStartOf="@+id/arrow_icon"
        app:layout_constraintStart_toEndOf="@+id/dot_icon"
        app:layout_constraintTop_toTopOf="@+id/artist_name"
        tools:text="2:55" />

    <ImageView
        android:id="@+id/arrow_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_8_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/search_hint" />

</androidx.constraintlayout.widget.ConstraintLayout>