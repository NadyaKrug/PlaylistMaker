<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/search_bg"
    android:orientation="vertical">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/search_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_height"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/settings_icon"
        app:title="@string/search"
        app:titleTextColor="@color/settings_text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginHorizontal="@dimen/main_padding"
        android:layout_marginTop="@dimen/icon_padding"
        android:background="@drawable/search_input_background"
        android:paddingHorizontal="@dimen/layout_medium">


        <ImageView
            android:layout_width="@dimen/main_padding"
            android:layout_height="@dimen/main_padding"
            android:src="@drawable/ic_search"
            android:layout_gravity="start|center_vertical"
            app:tint="@color/search_hint" />

        <EditText
            android:id="@+id/search_edit_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/layout_marginBottom"
            android:layout_marginEnd="@dimen/layout_marginBottom"
            android:hint="@string/search"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/search_text"
            android:textSize="16sp"
            android:fontFamily="@font/ys_display_regular"
            android:textColorHint="@color/search_hint"
            android:background="@null"
            android:textCursorDrawable="@drawable/blue_cursor"
            android:imeOptions="actionDone"
            android:singleLine="true"/>



        <ImageView
            android:id="@+id/clear_icon"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_clear_16"
            android:layout_gravity="end|center_vertical"
            android:scaleType="center"
            android:visibility="gone"
            app:tint="@color/search_hint" />


    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/track_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/main_padding"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />


    <LinearLayout
        android:id="@+id/nothing_found"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_zero"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/layout_max"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_nothing_found_120" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/main_padding"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/nothing_found"
            android:textAlignment="center"
            android:textColor="@color/error_text"
            android:textSize="@dimen/text_error" />

</LinearLayout>

    <LinearLayout
        android:id="@+id/server_error"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_zero"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/layout_max"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_server_error" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/server_error"
            android:textAlignment="center"
            android:textColor="@color/error_text"
            android:textSize="@dimen/text_error" />

        <Button
            android:id="@+id/refresh_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_max"
            android:text="@string/refresh" />
</LinearLayout>
</LinearLayout>