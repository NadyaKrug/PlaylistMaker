<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/search_bg"
    android:orientation="vertical">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/search_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_height"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/settings_icon"
        app:title="@string/search"
        app:titleTextColor="@color/settings_text" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginHorizontal="@dimen/main_padding"
        android:layout_marginTop="@dimen/icon_padding"
        android:background="@drawable/search_input_background"
        android:paddingHorizontal="@dimen/layout_medium">


        <ImageView
            android:layout_width="@dimen/main_padding"
            android:layout_height="@dimen/main_padding"
            android:src="@drawable/ic_search"
            android:layout_gravity="start|center_vertical"
            app:tint="@color/search_hint" />
        
        <EditText
            android:id="@+id/search_edit_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/layout_marginBottom"
            android:layout_marginEnd="@dimen/layout_marginBottom"
            android:hint="@string/search"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/search_text"
            android:textSize="16sp"
            android:fontFamily="@font/ys_display_regular"
            android:textColorHint="@color/search_hint"
            android:background="@null"
            android:textCursorDrawable="@drawable/blue_cursor"/>

        <ImageView
            android:id="@+id/clear_icon"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_clear"
            android:layout_gravity="end|center_vertical"
            android:scaleType="center"
            android:visibility="gone"
            app:tint="@color/search_hint" />


    </FrameLayout>


</LinearLayout>